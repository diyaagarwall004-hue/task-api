{
  "info": {
    "name": "Task API - update, ownership, sorting, RBAC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the whole collection with the Collection Runner (server on baseUrl). Each run uses fresh users. Note: login and signup are rate limited (10 logins per 15 min, 5 sign-ups per hour per IP by default); raise LOGIN_RATE_LIMIT and SIGNUP_RATE_LIMIT in .env if you run it many times in a row."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run') || pm.info.iteration === 0 && pm.info.requestName.startsWith('1.')) { pm.collectionVariables.set('run', Date.now()); }",
          "pm.collectionVariables.set('futureDue', new Date(Date.now() + 3*24*3600*1000).toISOString());",
          "pm.collectionVariables.set('pastDue', new Date(Date.now() - 24*3600*1000).toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "run",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Signup user A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"User A\",\n  \"email\": \"a_{{run}}@test.com\",\n  \"password\": \"password123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 created\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Signup user B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"User B\",\n  \"email\": \"b_{{run}}@test.com\",\n  \"password\": \"password123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 created\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Login user A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a_{{run}}@test.com\",\n  \"password\": \"password123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 and token\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().token).to.be.a('string'); });",
              "pm.test(\"role is user with no admin permissions\", () => { const u = pm.response.json().user; pm.expect(u.role).to.eql('user'); pm.expect(u.permissions).to.eql([]); });",
              "pm.collectionVariables.set('tokenA', pm.response.json().token);",
              "pm.collectionVariables.set('userAId', pm.response.json().user.id);"
            ]
          }
        }
      ]
    },
