      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "const { tasks, pagination } = pm.response.json();",
              "pm.test(\"returns tasks with pagination info\", () => { pm.expect(tasks).to.be.an('array'); pm.expect(pagination.total).to.be.at.least(2); });",
              "pm.test(\"sorted newest first\", () => { for (let i = 1; i < tasks.length; i++) { const a = new Date(tasks[i-1].createdAt), b = new Date(tasks[i].createdAt); pm.expect(a >= b).to.be.true; if (+a === +b) pm.expect(tasks[i-1].id > tasks[i].id).to.be.true; } });",
              "pm.test(\"task 2 is before task 1\", () => { const ids = tasks.map(x => String(x.id)); pm.expect(ids.indexOf(String(pm.collectionVariables.get('task2')))).to.be.below(ids.indexOf(String(pm.collectionVariables.get('task1')))); });"
            ]
          }
        }
      ]
