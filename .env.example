# ---- Required (the server will not start without these) ----
# PostgreSQL connection string (Neon or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Secret used to sign login tokens: at least 16 random characters
JWT_SECRET="replace-with-a-long-random-string"

# ---- Optional ----
# Websites allowed to call the API from another origin, comma-separated.
# The built-in frontend is served from the same origin and does not need this.
CORS_ORIGINS="https://task-api-n64f.onrender.com"

# Reminder emails (Gmail): turn on 2-step verification, then create an App Password
# at https://myaccount.google.com/apppasswords and paste the 16 characters here.
MAIL_USER="your.sender@gmail.com"
MAIL_PASS="xxxx xxxx xxxx xxxx"

# Secret key the scheduler (cron-job.org) must send to /api/cron/send-reminders
CRON_SECRET="another-long-random-string"

# Rate limits per IP address (defaults shown)
# LOGIN_RATE_LIMIT=10    # login attempts per 15 minutes
# SIGNUP_RATE_LIMIT=5    # sign-ups per hour
